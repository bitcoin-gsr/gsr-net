[Unit]
Description=gsr-net 30-second Signet miner
After=gsr-net-node.service
Requires=gsr-net-node.service

[Service]
Type=simple
User=gsrnet
Group=gsrnet
ExecStartPre=/opt/gsr-net/bin/bitcoin-cli -datadir=/var/lib/gsr-net -conf=/etc/gsr-net/bitcoin.conf -rpcwait -rpcwaittimeout=300 getblockcount
ExecStart=/usr/bin/python3 /opt/gsr-net/core/contrib/signet/miner "--cli=/opt/gsr-net/bin/bitcoin-cli -datadir=/var/lib/gsr-net -conf=/etc/gsr-net/bitcoin.conf -rpcwallet=miner" generate "--grind-cmd=/opt/gsr-net/bin/bitcoin-util grind" --address=tb1q0pmgzvwqh486tesv240fnddzwnmfrp3jggelr2 --nbits=1e0377ae --ongoing --poisson --poolid=/gsr-net/
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gsr-net

[Install]
WantedBy=multi-user.target
